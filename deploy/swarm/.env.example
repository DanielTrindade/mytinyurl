# ─────────────────────────────────────────────────────────────────────────────
# Exemplo de .env.production para deploy com Docker Swarm
#
# Copie este arquivo:
#   cp deploy/swarm/.env.example deploy/swarm/.env.production
#
# ⚠️  NUNCA commite o .env.production — ele já está no .gitignore.
#
# Valores sensíveis devem ser criados como Docker Secrets ANTES do deploy:
#
#   echo "token-longo-e-aleatorio"  | docker secret create admin_token -
#   echo "postgresql://..."          | docker secret create database_urls -
#   echo "senha-redis-forte"         | docker secret create redis_password -
#   echo "senha-grafana-forte"       | docker secret create grafana_admin_password -
#
# Essas variáveis NÃO precisam estar neste arquivo.
# ─────────────────────────────────────────────────────────────────────────────

APP_DOMAIN=go.seudominio.com
APP_URL=https://go.seudominio.com
LETSENCRYPT_EMAIL=ops@seudominio.com
CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com,https://meuprojeto.pages.dev
BACKEND_REPLICAS=1
WORKER_REPLICAS=1
DEFAULT_EXPIRATION_HOURS=24
MACHINE_ID=1
ENABLE_DOCS=false
BLOCK_PRIVATE_TARGETS=true
MAX_URL_LENGTH=2048
MAX_REQUEST_BODY_BYTES=4096
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_SHORTEN=20
RATE_LIMIT_MAX_STATS=30
RATE_LIMIT_MAX_REDIRECT=300
RATE_LIMIT_MAX_HEALTH=60
