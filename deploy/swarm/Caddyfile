{
	email {$LETSENCRYPT_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Bloqueia acesso externo à documentação da API
	@blocked_docs path /docs /docs/*
	respond @blocked_docs 404

	# Bloqueia acesso externo aos endpoints de saúde internos
	@blocked_health path /health /api/health /api/admin/health
	respond @blocked_health 404

	header {
		# HSTS: força HTTPS por 1 ano
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Remove o header Server para não expor que o proxy é Caddy
		-Server
		# Content-Security-Policy para a API:
		# Bloqueia iframes, scripts e recursos de origens externas inesperadas.
		# O backend é uma API JSON — sem scripts externos ou recursos embarcados.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# Não cachear respostas da API no browser/CDN
		Cache-Control "no-store"
	}

	reverse_proxy backend:3000 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
		health_status 2xx

		# Timeouts para evitar conexões penduradas
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
